# =============================================================================
# TreakHigh Quiz Platform — Environment Configuration Template
# =============================================================================
# USAGE:
#   1. Copy this file:  cp .env.example .env
#   2. Replace EVERY placeholder below with real values.
#   3. NEVER commit .env to version control.
#
# SECRET GENERATION COMMANDS:
#   Strong password:     openssl rand -base64 32
#   Hex key:             openssl rand -hex 32
#   n8n encryption key:  openssl rand -hex 24
#
# PgBouncer auth (SCRAM-SHA-256):
#   1. Start the database:  docker compose up -d postgres
#   2. Retrieve the hash:
#      docker exec treakhigh-db psql -U <USER> -d quiz_platform -t \
#        -c "SELECT rolpassword FROM pg_authid WHERE rolname = '<USER>';"
#   3. Paste the result into postgres/pgbouncer/userlist.txt
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=quiz_platform

# ── PgBouncer ────────────────────────────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD above.
# AUTH_FILE is mounted; this is only for fallback env-based auth.
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MAX_CLIENT_CONN=1000

# ── Redis ────────────────────────────────────────────────────────────────────
# Used by n8n queue mode. Must match the --requirepass flag in docker-compose.
REDIS_PASSWORD=CHANGE_ME

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# ── HMAC Signing (server-side only — NEVER expose to frontend) ──────────────
HMAC_SECRET=CHANGE_ME

# ── Nginx ────────────────────────────────────────────────────────────────────
# Rate limit requests per second to the telemetry endpoint
RATE_LIMIT_RPS=10
